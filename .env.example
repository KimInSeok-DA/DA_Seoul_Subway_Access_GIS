# .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다.

# VWorld 인증키 — 법정동 경계 데이터 API
VWORLD_API_KEY=

# ArcGIS Location Platform 계정 — publish 단계에서만 사용
# 포털 주소: 로그인 후 주소창이 https://○○○.maps.arcgis.com 이면 그 주소, 모르면 기본값
ARCGIS_URL=https://www.arcgis.com
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# 서울 열린데이터광장 인증키 — 서울시 역사마스터 좌표 대조용
SEOUL_API_KEY=
